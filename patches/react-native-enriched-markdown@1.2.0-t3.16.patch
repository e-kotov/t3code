+++ b/android/src/main/java/com/swmansion/enriched/markdown/utils/text/view/CitationSelectionContext.kt
@@ -0,0 +1,13 @@
+package com.swmansion.enriched.markdown.utils.text.view
+
+private val citationWhitespace = Regex("[\\s\\p{Z}\\uFEFF]+")
+
+/** Context uses the desktop selector's normalized whitespace and UTF-16 limit. */
+internal fun citationSelectionContext(text: String, start: Int, end: Int): Pair<String, String> {
+  if (start < 0 || end < start || end > text.length) return "" to ""
+  var prefix = text.substring(0, start).replace(citationWhitespace, " ").takeLast(32)
+  var suffix = text.substring(end).replace(citationWhitespace, " ").take(32)
+  if (prefix.firstOrNull()?.isLowSurrogate() == true) prefix = prefix.drop(1)
+  if (suffix.lastOrNull()?.isHighSurrogate() == true) suffix = suffix.dropLast(1)
+  return prefix to suffix
+}
diff --git a/android/src/test/java/com/swmansion/enriched/markdown/utils/text/view/CitationSelectionContextTest.kt b/android/src/test/java/com/swmansion/enriched/markdown/utils/text/view/CitationSelectionContextTest.kt
new file mode 100644
--- /dev/null
+++ b/android/src/test/java/com/swmansion/enriched/markdown/utils/text/view/CitationSelectionContextTest.kt
@@ -0,0 +1,27 @@
+package com.swmansion.enriched.markdown.utils.text.view
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CitationSelectionContextTest {
+  @Test fun repeatedPhrasesKeepTheirOwnContext() {
+    val text = "First quote ends. Second quote belongs here."
+    val start = text.lastIndexOf("quote")
+    assertEquals("First quote ends. Second " to " belongs here.", citationSelectionContext(text, start, start + 5))
+  }
+
+  @Test fun matchesDesktopWhitespace() {
+    assertEquals("before " to " after", citationSelectionContext("before\n\tquote\u00a0 after", 8, 13))
+  }
+
+  @Test fun boundsContextWithoutBreakingEmoji() {
+    val text = "😀" + "a".repeat(31) + "quote" + "b".repeat(31) + "😀"
+    assertEquals("a".repeat(31) to "b".repeat(31), citationSelectionContext(text, 33, 38))
+  }
+
+  @Test fun handlesFragmentEdgesAndInvalidBounds() {
+    assertEquals("" to "", citationSelectionContext("quote", 0, 5))
+    assertEquals("" to "", citationSelectionContext("quote", -1, 5))
+    assertEquals("" to "", citationSelectionContext("quote", 0, 6))
+  }
+}
